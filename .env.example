# Vorlage fuer die .env einer Installation.
#
#   cp .env.example .env
#
# Danach ALLE mit CHANGEME markierten Werte ersetzen. Die .env wird von git
# ignoriert und darf niemals eingecheckt werden.
#
# Geheimnisse erzeugen (Linux/macOS):
#   openssl rand -base64 36
# Unter Windows (PowerShell):
#   [Convert]::ToBase64String((1..36 | ForEach-Object { Get-Random -Max 256 }))

# ─── Datenbank ────────────────────────────────────────────────────────────────
POSTGRES_DB=mietverwaltung
POSTGRES_USER=mietuser
POSTGRES_PASSWORD=CHANGEME_ZUFAELLIGES_PASSWORT

# ─── Anmeldung ────────────────────────────────────────────────────────────────
# Mindestens 32 zufaellige Zeichen. Wird der Wert spaeter geaendert, sind alle
# ausgestellten Anmeldungen sofort ungueltig.
# Geprueft wird nicht nur die Laenge, sondern auch die Vielfalt: mindestens 16
# verschiedene Zeichen, und "CHANGEME" darf nicht mehr darin stehen. 40-mal
# dasselbe Zeichen waere lang genug und trotzdem in einem Versuch geraten. Der
# Container startet nicht, solange das nicht stimmt.
JWT_SECRET=CHANGEME_MINDESTENS_32_ZUFAELLIGE_ZEICHEN
# Gueltigkeitsdauer der Anmeldung. Wird serverseitig zusaetzlich erzwungen.
# Leer lassen ist NICHT erlaubt -- daraus entstuenden Tokens ohne Ablauf.
JWT_EXPIRES_IN=7d

# ─── Erster Administrator ─────────────────────────────────────────────────────
# Wird nur beim allerersten Start angelegt. Ohne diese beiden Werte startet der
# Backend-Container nicht -- absichtlich, damit keine Installation mit einem
# vorhersehbaren Passwort ins Netz geht.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGEME_MINDESTENS_12_ZEICHEN

# ─── Netz ─────────────────────────────────────────────────────────────────────
# Port, unter dem die Anwendung auf dem Host erreichbar ist. Davor gehoert ein
# Reverse Proxy mit TLS; siehe INSTALL.md.
APP_PORT=8080
# Oeffentliche Adresse der Anwendung. Steht in E-Mails, die die Anwendung versendet.
APP_URL=https://mietverwaltung.example.com

# Adressen, deren X-Forwarded-For geglaubt wird. Der Vorgabewert deckt localhost
# und genau das interne Docker-Netz ab. Laeuft der Reverse Proxy auf einer ANDEREN
# Maschine, muss dessen Adresse hier ergaenzt werden -- sonst sieht die
# Ratenbegrenzung alle Nutzer als einen einzigen Absender.
# Bewusst keine Wildcard: wer hier zu viel eintraegt, macht die Anmeldesperre
# umgehbar, weil ein Client den Kopf dann selbst setzen kann.
TRUST_PROXY=127.0.0.1, ::1, 172.28.0.0/16

# Adressbereich des internen Docker-Netzes. Ausdruecklich festgelegt, damit
# TRUST_PROXY oben genau dieses Netz nennen kann statt pauschal 172.16.0.0/12 --
# das waeren eine Million Adressen, denen ein X-Forwarded-For geglaubt wuerde.
# Kollidiert der Bereich mit einem vorhandenen Netz, hier UND in TRUST_PROXY
# aendern; Compose kann Variablen nicht ineinander einsetzen.
DOCKER_SUBNET=172.28.0.0/16

# ─── Ablage ───────────────────────────────────────────────────────────────────
# Verzeichnis auf dem HOST, in dem die hochgeladenen Dokumente liegen. Es muss
# VOR dem ersten Start existieren -- fehlt es, legt Docker es zwar an, aber die
# Dateien landen je nach Konfiguration in der Container-Schicht und sind beim
# naechsten "docker compose down" verloren. Siehe INSTALL.md.
DOKUMENT_PFAD=/data/mietverwaltung/dokumente

# ─── E-Mail-Versand (optional) ────────────────────────────────────────────────
# Wird fuer Mahnungen und den Versand von Abrechnungen gebraucht. Bleibt das
# Feld leer, laeuft die Anwendung, kann aber keine Post verschicken.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mietverwaltung <noreply@example.com>"

# ─── Ressourcen (optional) ────────────────────────────────────────────────────
# Obergrenzen fuer den Arbeitsspeicher. Beim Backend grosszuegig gewaehlt: die
# Texterkennung braucht je Seite ordentlich Speicher, und ein Abschuss mitten
# darin laesst das Dokument haengen.
BACKEND_MEMORY_LIMIT=3g
DB_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=256m

# ─── Image-Auswahl ────────────────────────────────────────────────────────────
# Waehlt die Image-Version. Empfohlen ist eine feste Version statt latest:
# dann entscheidet man selbst, wann ein neuer Stand kommt.
#   1.1.2     feste Version -- OHNE "v": docker/metadata-action schneidet
#             das Praefix des Git-Tags ab. "v1.1.2" gibt es in der Registry nicht.
#   1.1       jeweils die neueste 1.1.x
#   latest    jeweils der aktuelle master-Stand
#   feature-* Branch-Abbild (Testserver)
IMAGE_TAG=latest
# Namensraum der Images. Nur aendern, wer das Repository geforkt hat und in
# seinen eigenen Namensraum veroeffentlicht.
IMAGE_NAMESPACE=nikc112
